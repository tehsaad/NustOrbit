# Orbit environment variables — placeholders only. Never commit real values.
# Copy to .env.local for local development (`vercel env pull` fills most of these).

# ── Database (PostgreSQL; Neon via the Vercel Marketplace in production) ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"          # pooled, used by the app
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require" # direct, used by migrations

# ── Authentication (Better Auth) ──
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"          # production: https://your-domain
SESSION_IDLE_DAYS="14"                           # session expires after this many days unused
SESSION_ABSOLUTE_DAYS="60"                       # hard cap since sign-in
AUTH_SIGNIN_RATE_MAX="5"                         # failed sign-ins per IP per 15 min (keep 5 in production)
SETUP_TOKEN="generate-with: openssl rand -base64 24"  # one-time admin setup; remove after setup

# ── Credential vault (AES-256-GCM for integration secrets) ──
ORBIT_VAULT_KEY="generate-with: openssl rand -base64 32"
ORBIT_VAULT_KEY_VERSION="1"
ORBIT_VAULT_KEY_PREVIOUS=""                      # only during key rotation

# ── Scheduling ──
CRON_SECRET="generate-with: openssl rand -base64 32"  # Bearer token for /api/cron/*

# ── App defaults ──
ORBIT_TIMEZONE="Asia/Karachi"
LMS_ALLOWED_HOSTS="lms.nust.edu.pk"              # hosts allowed for LMS calendar links / web services

# ── Google (Calendar + Gmail) — optional ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Web Push (VAPID) — optional; generate with: npx web-push generate-vapid-keys ──
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Email (Resend) for password reset + email reminders — optional ──
RESEND_API_KEY=""
EMAIL_FROM="Orbit <orbit@your-verified-domain.com>"
